{
  "description": "RECLAIM development guardrails. Advisory except for clearly destructive tool calls.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/reclaim_hooks.py\" --event SessionStart",
            "commandWindows": "cmd.exe /D /C .codex\\hooks\\reclaim_hooks.cmd --event SessionStart",
            "statusMessage": "Loading RECLAIM development context",
            "timeout": 10,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/reclaim_hooks.py\" --event PreToolUse",
            "commandWindows": "cmd.exe /D /C .codex\\hooks\\reclaim_hooks.cmd --event PreToolUse",
            "statusMessage": "Checking RECLAIM destructive-command guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/reclaim_hooks.py\" --event PostToolUse",
            "commandWindows": "cmd.exe /D /C .codex\\hooks\\reclaim_hooks.cmd --event PostToolUse",
            "statusMessage": "Reviewing RECLAIM changed paths",
            "timeout": 10,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/reclaim_hooks.py\" --event Stop",
            "commandWindows": "cmd.exe /D /C .codex\\hooks\\reclaim_hooks.cmd --event Stop",
            "statusMessage": "Preparing RECLAIM handoff check",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

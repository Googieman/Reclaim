{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reclaim.local/schemas/evaluation-manifest-v1.0.0.json",
  "title": "RECLAIM evaluation corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "corpus_version", "case_count", "target_case_count", "provenance_categories", "label_schema", "class_balance", "split_metadata", "source_dataset", "synthetic_overlay", "seed_version", "environment_version", "limitations", "cases"],
  "properties": {
    "manifest_version": {"type": "string", "const": "evaluation-manifest-v1.0.0"},
    "corpus_version": {"type": "string", "minLength": 1},
    "case_count": {"type": "integer", "minimum": 0},
    "target_case_count": {"type": "integer", "minimum": 1},
    "provenance_categories": {"type": "array", "items": {"enum": ["REAL_DISTRIBUTION", "RAZORPAY_TEST", "SYNTHETIC_OVERLAY"]}, "uniqueItems": true},
    "label_schema": {
      "type": "object", "additionalProperties": false,
      "required": ["attribution_labels", "terminal_outcomes"],
      "properties": {
        "attribution_labels": {"type": "array", "items": {"enum": ["malicious", "legitimate", "uncertain"]}},
        "terminal_outcomes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "class_balance": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "split_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["target_ratios", "actual_counts", "assignments_frozen_before_overlay", "held_out_sealed"],
      "properties": {
        "target_ratios": {"type": "object", "required": ["development", "validation", "held_out"], "additionalProperties": false, "properties": {"development": {"type": "number", "minimum": 0, "maximum": 1}, "validation": {"type": "number", "minimum": 0, "maximum": 1}, "held_out": {"type": "number", "minimum": 0, "maximum": 1}}},
        "actual_counts": {"type": "object", "required": ["development", "validation", "held_out"], "additionalProperties": false, "properties": {"development": {"type": "integer", "minimum": 0}, "validation": {"type": "integer", "minimum": 0}, "held_out": {"type": "integer", "minimum": 0}}},
        "assignments_frozen_before_overlay": {"type": "boolean", "const": true},
        "held_out_sealed": {"type": "boolean", "const": true}
      }
    },
    "source_dataset": {"type": "object", "required": ["name", "available_case_count", "source_references"], "properties": {"name": {"type": "string", "minLength": 1}, "available_case_count": {"type": "integer", "minimum": 0}, "source_references": {"type": "array", "items": {"type": "string"}}}},
    "synthetic_overlay": {"type": "object", "required": ["generated_after_split", "available_case_count", "generated_case_count"], "properties": {"generated_after_split": {"type": "boolean", "const": true}, "available_case_count": {"type": "integer", "minimum": 0}, "generated_case_count": {"type": "integer", "minimum": 0}}},
    "seed_version": {"type": "object", "required": ["seed", "version"], "properties": {"seed": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "environment_version": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation_case_id", "provenance", "split", "entity_group_id", "temporal_boundary"],
      "properties": {
        "evaluation_case_id": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "split": {"enum": ["development", "validation", "held_out"]},
        "entity_group_id": {"type": "string", "minLength": 1},
        "customer_group_id": {"type": ["string", "null"]},
        "temporal_boundary": {"type": "string", "format": "date-time"},
        "sealed": {"type": "boolean"},
        "content_checksum": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}

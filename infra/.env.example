# Copy to .env for local development; this file contains no credentials.
RECLAIM_ENVIRONMENT=development
RECLAIM_TENANT_ID=demo-tenant
RECLAIM_RUN_MODE=replay
RECLAIM_REPLAY_LABEL=replay
RECLAIM_LIVE_ACTIONS_ENABLED=false
RECLAIM_LIVE_FINANCIAL_ACTIONS_ENABLED=false
RECLAIM_PROVIDER_UNAVAILABILITY_POLICY=replay
# Byte limits at the incident, webhook, and immutable raw-object boundaries.
RECLAIM_INCIDENT_REPORT_MAX_BYTES=1048576
RECLAIM_WEBHOOK_MAX_BYTES=1048576
RECLAIM_RAW_OBJECT_MAX_BYTES=16777216
RECLAIM_RPO_MINUTES=15
RECLAIM_RTO_MINUTES=60
RECLAIM_BACKUP_RETENTION_DAYS=35
RECLAIM_DATABASE_URL=postgresql://reclaim:reclaim@postgres:5432/reclaim
RECLAIM_TEMPORAL_TARGET=temporal:7233
RECLAIM_REDPANDA_BROKERS=redpanda:9092
RECLAIM_REDIS_URL=redis://redis:6379/0
RECLAIM_MINIO_ENDPOINT=minio:9000
RECLAIM_KEYCLOAK_ISSUER=http://keycloak:8080/realms/reclaim
RECLAIM_VAULT_ADDRESS=http://vault:8200
RECLAIM_ORCHESTRATION_PROVIDER=n8n
RECLAIM_N8N_API_BASE_URL=http://n8n-main:5678
RECLAIM_N8N_WORKFLOW_VERSION=incident-analysis-handoff.v1
# RECLAIM_N8N_SERVICE_TOKEN=configure-out-of-band-for-bootstrap
# RECLAIM_N8N_CREDENTIAL_REVISION=v1

# Production overlay only: all values are deployment-secret-manager inputs.
# The production overlay fails closed when these are missing; do not copy
# test values into a production environment.
# RECLAIM_API_IMAGE=registry.example/reclaim-api@sha256:<immutable-digest>
# RECLAIM_WEB_IMAGE=registry.example/reclaim-web@sha256:<immutable-digest>
# RECLAIM_OIDC_AUDIENCE=reclaim-api
# RECLAIM_OIDC_JWKS_URL=https://identity.example/realms/reclaim/protocol/openid-connect/certs
# RECLAIM_VAULT_ADDRESS=https://vault.example.internal:8200
# RECLAIM_REDPANDA_SASL_USERNAME=reclaim-event-relay
# RECLAIM_REDPANDA_SASL_PASSWORD_FILE=/run/secrets/redpanda-sasl-password
# RECLAIM_REDPANDA_TLS_DIR=C:\\secrets\\redpanda
# RECLAIM_SECRET_DIR=C:\\secrets\\runtime
# RECLAIM_CONTROL_PLANE_TLS_DIR=C:\\secrets\\control-plane
# N8N_HOST=n8n.example.internal
# N8N_DB_PASSWORD=configure-out-of-band
# N8N_ENCRYPTION_KEY=configure-out-of-band
# KEYCLOAK_DB_USERNAME=keycloak
# KEYCLOAK_DB_PASSWORD=configure-out-of-band
# KEYCLOAK_HOSTNAME=identity.example.internal

# T153 validation is loopback-only; override only when running the isolated harness.
RECLAIM_WEB_PORT=13000
RECLAIM_API_PORT=18000
RECLAIM_POSTGRES_PORT=15432
RECLAIM_MINIO_PORT=19000
RECLAIM_REDPANDA_PORT=19092
RECLAIM_N8N_PORT=15678
# Optional per-run T153 Docker bridge subnets; use unique non-overlapping values
# when another isolated validation project already uses the defaults.
# RECLAIM_T153_PUBLIC_SUBNET=10.153.0.0/24
# RECLAIM_T153_APP_SUBNET=10.153.1.0/24
# RECLAIM_T153_DATA_SUBNET=10.153.2.0/24
# RECLAIM_T153_OBSERVABILITY_SUBNET=10.153.3.0/24
# RECLAIM_T153_PUBLISHED_SUBNET=10.153.4.0/24
N8N_DB_PASSWORD=reclaim-n8n-development
N8N_ENCRYPTION_KEY=reclaim-n8n-development-key-change-me
# JSON object consumed only by the idempotent bootstrap script; do not commit secrets.
# n8n 1.121 Kafka credential data uses a comma-separated broker string.
# N8N_KAFKA_CREDENTIAL_DATA_JSON={"clientId":"reclaim-t153","brokers":"redpanda:9092","ssl":false,"authentication":false}
# N8N_API_KEY=configure-out-of-band-for-bootstrap

{
  "template_only": true,
  "schema_version": "1.0.0",
  "status": "deployment-owned-identity-material-not-obtainable-from-the-broker",
  "secrets_broker": {
    "vault_address": "__REQUIRED_VAULT_HTTPS_ADDRESS__",
    "vault_auth_method": "cert",
    "vault_client_cert_pem": "__REQUIRED_VAULT_BROKER_AUTH_CERT_PEM__",
    "vault_client_key_pem": "__REQUIRED_VAULT_BROKER_AUTH_KEY_PEM__",
    "vault_ca_pem": "__REQUIRED_VAULT_CA_PEM__",
    "server_cert_pem": "__REQUIRED_BROKER_INTERNAL_DNS_CERT_PEM__",
    "server_key_pem": "__REQUIRED_BROKER_SERVER_KEY_PEM__",
    "client_ca_pem": "__REQUIRED_SERVICE_CLIENT_CA_PEM__"
  },
  "service_identity_template": {
    "apply_separately_to": [
      "intake-api",
      "action-gateway",
      "model-provider",
      "event-relay",
      "n8n-main",
      "n8n-worker",
      "deployment-job",
      "projection-worker",
      "telemetry-collector",
      "evaluator",
      "mlflow-server",
      "agent-runner",
      "web-bff"
    ],
    "client_cert_pem": "__REQUIRED_DISTINCT_SERVICE_CLIENT_CERT_PEM__",
    "client_key_pem": "__REQUIRED_DISTINCT_SERVICE_CLIENT_KEY_PEM__",
    "server_ca_pem": "__REQUIRED_BROKER_SERVER_CA_PEM__",
    "reuse_between_services": false
  },
  "web_bff": {
    "oidc_client_secret": "__REQUIRED_WEB_OIDC_CLIENT_SECRET__",
    "session_encryption_key": "__REQUIRED_WEB_SESSION_ENCRYPTION_KEY__"
  },
  "identity_provider": {
    "keycloak_db_password": "__REQUIRED_KEYCLOAK_DB_PASSWORD_IF_SELF_HOSTED__",
    "keycloak_initial_admin_password": "__REQUIRED_KEYCLOAK_INITIAL_ADMIN_PASSWORD_IF_SELF_HOSTED__"
  },
  "deployment_only": {
    "render_api_key": "__OPTIONAL_RENDER_API_KEY_FOR_CLI_OR_CI_ONLY__",
    "postgres_migration_url": "__REQUIRED_MIGRATION_ROLE_DATABASE_URL__",
    "vault_provisioner_auth": "__REQUIRED_OPERATOR_VAULT_AUTH_NOT_RUNTIME_ROOT_TOKEN__"
  },
  "never_place_here": [
    "private CA signing key",
    "Vault root token",
    "Vault unseal or recovery keys",
    "real merchant Razorpay Live keys"
  ]
}
